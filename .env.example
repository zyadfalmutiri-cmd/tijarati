# Supabase (leave empty to run the app in local demo/mock-data mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=demo # demo | live

# Optional: power the AI assistant with a real LLM (falls back to the built-in
# rule-based analytics engine if not provided)
ANTHROPIC_API_KEY=

# Integration adapters — API key based connectors (OAuth ones use the
# per-connector CLIENT_ID / CLIENT_SECRET / REDIRECT_URI pattern, see
# src/lib/integrations/adapters/*)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
STRIPE_API_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
